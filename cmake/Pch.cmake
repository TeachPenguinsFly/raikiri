# simdjson goes only into the pch of targets that link it
# build with RAIKIRI_PCH=OFF to catch includes the pch hides

function(_raikiri_pch_targets dir out)
  get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(sub IN LISTS subdirs)
    _raikiri_pch_targets("${sub}" sub_targets)
    list(APPEND targets ${sub_targets})
  endforeach()
  set(${out} "${targets}" PARENT_SCOPE)
endfunction()

# relative to raikiri so it also works as a subproject
set(RAIKIRI_PCH_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")

# one carrier per header set and per code model: clang and gcc refuse a pch built as -fPIC in an
# executable built as -fPIE, and -Wpedantic alone changes gcc's predefined macros
function(_raikiri_pch_carrier name header)
  set(stub "${CMAKE_BINARY_DIR}/raikiri_pch.cpp")
  add_library(${name} STATIC "${stub}")
  add_library(${name}_exe STATIC "${stub}")
  set_target_properties(${name}_exe PROPERTIES POSITION_INDEPENDENT_CODE OFF)
  target_compile_options(${name}_exe PRIVATE -fPIE)
  foreach(t ${name} ${name}_exe)
    target_link_libraries(${t} PRIVATE raikiri::warnings ${ARGN})
    target_precompile_headers(${t} PRIVATE "${RAIKIRI_PCH_ROOT}/cmake/${header}")
  endforeach()
endfunction()

function(raikiri_enable_pch)
  file(WRITE "${CMAKE_BINARY_DIR}/raikiri_pch.cpp" "// generated: carrier TU for the shared precompiled headers\n")
  _raikiri_pch_carrier(raikiri_pch pch_std.hpp)
  _raikiri_pch_carrier(raikiri_pch_json pch_json.hpp simdjson::simdjson)
  set(carriers raikiri_pch raikiri_pch_exe raikiri_pch_json raikiri_pch_json_exe)
  if(RAIKIRI_BUILD_TESTS)
    _raikiri_pch_carrier(raikiri_pch_tests pch_tests.hpp GTest::gtest)
    list(APPEND carriers raikiri_pch_tests raikiri_pch_tests_exe)
  endif()

  _raikiri_pch_targets("${RAIKIRI_PCH_ROOT}" all_targets)
  foreach(t IN LISTS all_targets)
    if(t IN_LIST carriers)
      continue()
    endif()
    get_target_property(type ${t} TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY" OR type STREQUAL "UTILITY")
      continue()
    endif()
    set(model "")
    if(type STREQUAL "EXECUTABLE")
      set(model "_exe")
    endif()
    get_target_property(src_dir ${t} SOURCE_DIR)
    get_target_property(links ${t} LINK_LIBRARIES)
    if(src_dir MATCHES "/tests")
      target_precompile_headers(${t} REUSE_FROM raikiri_pch_tests${model})
    elseif(links MATCHES "simdjson")
      target_precompile_headers(${t} REUSE_FROM raikiri_pch_json${model})
    else()
      target_precompile_headers(${t} REUSE_FROM raikiri_pch${model})
    endif()
  endforeach()
endfunction()
