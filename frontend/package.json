{
  "name": "raikiri-frontend",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w raikiri-terminal --",
    "build": "npm run types && tsc -b && npm run build -w raikiri-terminal",
    "preview": "npm run preview -w raikiri-terminal --",
    "types": "openapi-typescript ../schema/admin-api.yaml -o packages/terminal/src/api/types.ts",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.18.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
