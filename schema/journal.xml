<?xml version="1.0" encoding="UTF-8"?>
<!--
  Journal record schema: the single source of truth for everything that
  crosses a durability or language boundary. C++ hot writers encode with
  sbepp-generated codecs; the replay tool and persisterd decode the same
  headers; a future Go tailer can consume the identical XML. Schema evolution
  follows SBE rules: append fields, never reorder; bump version.

  Values follow the in-memory model: prices/qtys are instrument-scaled int64
  ticks/lots, rates and fees are 1e9 fixed-point, times are UnixNanos.
-->
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="raikiri.journal"
                   id="1"
                   version="4"
                   semanticVersion="0.1.0"
                   description="raikiri journal records"
                   byteOrder="littleEndian">
  <types>
    <composite name="messageHeader" description="SBE framing header">
      <type name="blockLength" primitiveType="uint16"/>
      <type name="templateId" primitiveType="uint16"/>
      <type name="schemaId" primitiveType="uint16"/>
      <type name="version" primitiveType="uint16"/>
    </composite>

    <type name="timestampNs" primitiveType="uint64" description="UnixNanos"/>
    <type name="priceTicks" primitiveType="int64"/>
    <type name="qtyLots" primitiveType="int64"/>
    <type name="fixedE9" primitiveType="int64"/>
    <type name="instrumentId" primitiveType="uint64" description="packed venue|market|symbol"/>
    <type name="clientOrderId" primitiveType="uint64" description="packed strategy|seq"/>
    <type name="exchangeClientOrderId" primitiveType="char" length="26" description="ULID"/>
    <type name="venueText" primitiveType="char" length="40" description="venue-minted id, space-padded"/>
    <type name="symbolText" primitiveType="char" length="24" description="venue wire symbol, space-padded"/>
    <type name="venueCode" primitiveType="int32" description="the venue's own numeric refusal code"/>

    <enum name="errorClassEnum" encodingType="uint8">
      <validValue name="Terminal">0</validValue>
      <validValue name="Retryable">1</validValue>
      <validValue name="RateLimited">2</validValue>
      <validValue name="AuthFailure">3</validValue>
      <validValue name="Connectivity">4</validValue>
    </enum>

    <enum name="venueIdEnum" encodingType="uint8">
      <validValue name="Binance">1</validValue>
      <validValue name="Bybit">2</validValue>
      <validValue name="Okx">3</validValue>
      <validValue name="Gate">4</validValue>
      <validValue name="Kucoin">5</validValue>
      <validValue name="Bingx">6</validValue>
      <validValue name="Xt">7</validValue>
      <validValue name="Mexc">8</validValue>
      <validValue name="Sim">9</validValue>
      <validValue name="Deribit">10</validValue>
      <validValue name="Hyperliquid">11</validValue>
      <validValue name="Coinbase">12</validValue>
      <validValue name="Kraken">13</validValue>
      <validValue name="Bitmex">14</validValue>
      <validValue name="Bitget">15</validValue>
      <validValue name="Htx">16</validValue>
      <validValue name="Bitfinex">17</validValue>
      <validValue name="Weex">18</validValue>
      <validValue name="Aster">19</validValue>
      <validValue name="Grvt">20</validValue>
      <validValue name="Lighter">21</validValue>
      <validValue name="Backpack">22</validValue>
      <validValue name="CryptoCom">23</validValue>
      <validValue name="Blofin">24</validValue>
      <validValue name="Apex">25</validValue>
      <validValue name="Edgex">26</validValue>
      <validValue name="Dydx">27</validValue>
      <validValue name="Phemex">28</validValue>
      <validValue name="Extended">29</validValue>
      <validValue name="Pacifica">30</validValue>
    </enum>

    <enum name="sideEnum" encodingType="uint8">
      <validValue name="Buy">0</validValue>
      <validValue name="Sell">1</validValue>
    </enum>

    <enum name="orderEventTypeEnum" encodingType="uint8">
      <validValue name="Initialized">0</validValue>
      <validValue name="Denied">1</validValue>
      <validValue name="Submitted">2</validValue>
      <validValue name="Accepted">3</validValue>
      <validValue name="Rejected">4</validValue>
      <validValue name="Triggered">5</validValue>
      <validValue name="PendingUpdate">6</validValue>
      <validValue name="Updated">7</validValue>
      <validValue name="ModifyRejected">8</validValue>
      <validValue name="PendingCancel">9</validValue>
      <validValue name="Canceled">10</validValue>
      <validValue name="CancelRejected">11</validValue>
      <validValue name="Expired">12</validValue>
      <validValue name="Filled">13</validValue>
      <validValue name="ReconGap">14</validValue>
      <validValue name="ReconClosed">15</validValue>
    </enum>

    <enum name="orderTypeEnum" encodingType="uint8">
      <validValue name="Limit">0</validValue>
      <validValue name="Market">1</validValue>
    </enum>

    <enum name="tifEnum" encodingType="uint8">
      <validValue name="Gtc">0</validValue>
      <validValue name="Ioc">1</validValue>
      <validValue name="Fok">2</validValue>
    </enum>

    <enum name="cmdKindEnum" encodingType="uint8">
      <validValue name="Create">0</validValue>
      <validValue name="Cancel">1</validValue>
    </enum>

    <enum name="connEventEnum" encodingType="uint8">
      <validValue name="Connected">0</validValue>
      <validValue name="Disconnected">1</validValue>
      <validValue name="AuthFailed">2</validValue>
      <validValue name="Resubscribed">3</validValue>
    </enum>

    <enum name="reconVerdictEnum" encodingType="uint8">
      <validValue name="Agree">0</validValue>
      <validValue name="Break">1</validValue>
      <validValue name="Unknown">2</validValue>
    </enum>

    <enum name="pnlKindEnum" encodingType="uint8">
      <validValue name="Realized">0</validValue>
      <validValue name="Fee">1</validValue>
      <validValue name="Funding">2</validValue>
    </enum>

    <enum name="settleSideEnum" encodingType="uint8">
      <validValue name="Quote">0</validValue>
      <validValue name="Base">1</validValue>
    </enum>

    <enum name="fundingAccrualEnum" encodingType="uint8">
      <validValue name="Unknown">0</validValue>
      <validValue name="Discrete">1</validValue>
      <validValue name="Continuous">2</validValue>
    </enum>

    <enum name="liquidityEnum" encodingType="uint8">
      <validValue name="Unknown">0</validValue>
      <validValue name="Maker">1</validValue>
      <validValue name="Taker">2</validValue>
    </enum>

    <enum name="contractKindEnum" encodingType="uint8">
      <validValue name="Unknown">0</validValue>
      <validValue name="Linear">1</validValue>
      <validValue name="Inverse">2</validValue>
    </enum>
  </types>

  <sbe:message name="OrderEventMsg" id="1" description="Order lifecycle event">
    <field name="eventType" id="1" type="orderEventTypeEnum"/>
    <field name="side" id="2" type="sideEnum"/>
    <field name="orderType" id="3" type="orderTypeEnum"/>
    <field name="tif" id="4" type="tifEnum"/>
    <field name="flags" id="5" type="uint8" description="bit0 postOnly, bit1 reduceOnly"/>
    <field name="liquidity" id="6" type="liquidityEnum"/>
    <field name="instrument" id="7" type="instrumentId"/>
    <field name="clientOrderIdField" id="8" type="clientOrderId"/>
    <field name="exchangeClientOrderIdField" id="9" type="exchangeClientOrderId"/>
    <field name="exchangeOrderIdField" id="10" type="venueText"/>
    <field name="execIdField" id="11" type="venueText"/>
    <field name="price" id="12" type="priceTicks"/>
    <field name="qty" id="13" type="qtyLots"/>
    <field name="leavesQty" id="14" type="qtyLots"/>
    <field name="fee" id="15" type="fixedE9"/>
    <field name="tsEvent" id="16" type="timestampNs"/>
    <field name="tsInit" id="17" type="timestampNs"/>
    <!-- WHY the venue refused, on the three Rejected kinds and meaningless
         elsewhere. Before these, a refusal reached the database carrying the
         fact of a rejection and no reason for it, and the cause existed only in
         a log line on whichever machine ran the gateway.
         sinceVersion=2: a record written before them is SHORTER, and a reader
         that does not check the frame's schema_version reads past its end. -->
    <field name="rejectClass" id="18" type="errorClassEnum" sinceVersion="2"/>
    <field name="rejectCode" id="19" type="venueCode" sinceVersion="2"/>
  </sbe:message>

  <sbe:message name="OrderCmdMsg" id="2" description="Order command as received/sent">
    <field name="kind" id="1" type="cmdKindEnum"/>
    <field name="side" id="2" type="sideEnum"/>
    <field name="orderType" id="3" type="orderTypeEnum"/>
    <field name="tif" id="4" type="tifEnum"/>
    <field name="flags" id="5" type="uint8"/>
    <field name="instrument" id="6" type="instrumentId"/>
    <field name="clientOrderIdField" id="7" type="clientOrderId"/>
    <field name="exchangeClientOrderIdField" id="8" type="exchangeClientOrderId"/>
    <field name="exchangeOrderIdField" id="9" type="venueText" description="cancels: target id"/>
    <field name="price" id="10" type="priceTicks"/>
    <field name="qty" id="11" type="qtyLots"/>
    <field name="tsCreated" id="12" type="timestampNs"/>
  </sbe:message>

  <sbe:message name="BboMsg" id="3" description="Sampled/changed best bid-offer">
    <field name="instrument" id="1" type="instrumentId"/>
    <field name="bid" id="2" type="priceTicks"/>
    <field name="ask" id="3" type="priceTicks"/>
    <field name="bidQty" id="4" type="qtyLots"/>
    <field name="askQty" id="5" type="qtyLots"/>
    <field name="tsEvent" id="6" type="timestampNs"/>
    <field name="tsInit" id="7" type="timestampNs"/>
  </sbe:message>

  <sbe:message name="TradeMsg" id="4" description="Public trade tick">
    <field name="instrument" id="1" type="instrumentId"/>
    <field name="price" id="2" type="priceTicks"/>
    <field name="qty" id="3" type="qtyLots"/>
    <field name="aggressor" id="4" type="sideEnum"/>
    <field name="tsEvent" id="5" type="timestampNs"/>
    <field name="tsInit" id="6" type="timestampNs"/>
  </sbe:message>

  <sbe:message name="FundingMsg" id="5" description="Funding rate observation">
    <field name="instrument" id="1" type="instrumentId"/>
    <field name="rate" id="2" type="fixedE9"/>
    <field name="predictedRate" id="3" type="fixedE9"/>
    <field name="markPrice" id="4" type="priceTicks"/>
    <field name="nextFundingTime" id="5" type="timestampNs"/>
    <field name="intervalS" id="6" type="uint32"/>
    <field name="tsEvent" id="7" type="timestampNs"/>
    <field name="tsInit" id="8" type="timestampNs"/>
    <field name="accrual" id="9" type="fundingAccrualEnum" sinceVersion="3"/>
  </sbe:message>

  <sbe:message name="ConnectivityMsg" id="6" description="Connection state transition">
    <field name="venue" id="1" type="venueIdEnum"/>
    <field name="event" id="2" type="connEventEnum"/>
    <field name="streamId" id="3" type="uint32" description="which WS within the gateway"/>
    <field name="tsInit" id="4" type="timestampNs"/>
  </sbe:message>

  <sbe:message name="LatencySampleMsg" id="7" description="Histogram snapshot row">
    <field name="venue" id="1" type="venueIdEnum"/>
    <field name="metric" id="2" type="uint16" description="metric id, registry in observ"/>
    <field name="p50Ns" id="3" type="uint64"/>
    <field name="p99Ns" id="4" type="uint64"/>
    <field name="p999Ns" id="5" type="uint64"/>
    <field name="maxNs" id="6" type="uint64"/>
    <field name="count" id="7" type="uint64"/>
    <field name="tsInit" id="8" type="timestampNs"/>
  </sbe:message>
  <!-- One increment of realized money. Appended by strategyd as fills realize,
       NOT re-derived downstream: a re-derivation depends on instrument data
       that can change under it, and the ledger has to record what the trading
       process actually computed.

       symbol travels as text beside the packed instrument id on purpose. The
       symbol half of that id is a catalogue load-order index, so it means a
       different instrument after a delisting shifts the list; the venue's own
       spelling does not move. -->
  <sbe:message name="PnlIncrementMsg" id="8" description="Append-only money increment">
    <field name="kind" id="1" type="pnlKindEnum"/>
    <field name="settleSide" id="2" type="settleSideEnum"/>
    <field name="strategyId" id="3" type="uint16"/>
    <field name="instrument" id="4" type="instrumentId"/>
    <field name="symbol" id="5" type="symbolText"/>
    <field name="clientOrderIdField" id="6" type="clientOrderId"/>
    <field name="execIdField" id="7" type="venueText"/>
    <field name="amount" id="8" type="fixedE9"/>
    <field name="tsEvent" id="9" type="timestampNs"/>
  </sbe:message>
  <!-- The book, as it stands after one fill moved it.
       Written by whichever process OWNS the arithmetic — strategyd — and never
       re-derived downstream. A second process folding the same fills would be
       a second answer to one question, and the two would drift: that exact bug
       cost this system a reconciliation that compared a venue against a number
       nobody was trading on.

       Emitted on change, not on a timer: a position that did not move has
       nothing to say, and a row per second would bury the ones that did.

       Cost, not average price. An average is cost divided by size and can be
       recomputed at any moment; storing it instead would fix it to the size it
       was computed at, and every later partial close would drift from it.

       Symbol travels as text for the same reason the PnL ledger carries it:
       the symbol half of a packed instrument id is a catalogue load-order
       index and moves under a delisting. -->
  <sbe:message name="PositionMsg" id="10" description="Position state after a fill">
    <field name="strategyId" id="1" type="uint16"/>
    <field name="settleSide" id="2" type="settleSideEnum"/>
    <field name="venue" id="3" type="venueIdEnum"/>
    <field name="instrument" id="4" type="instrumentId"/>
    <field name="symbol" id="5" type="symbolText"/>
    <field name="netQty" id="6" type="qtyLots"/>
    <field name="cost" id="7" type="fixedE9"/>
    <field name="realized" id="8" type="fixedE9"/>
    <field name="fees" id="9" type="fixedE9"/>
    <field name="fillCount" id="10" type="uint32"/>
    <field name="tsOpened" id="11" type="timestampNs"/>
    <field name="tsUpdated" id="12" type="timestampNs"/>
  </sbe:message>
  <!-- A disagreement between this process and the venue about what is held.
       Written only when the two differ: an agreement every 30s would bury the
       one line that matters. Symbol travels as text for the same reason the
       PnL ledger carries it — the symbol half of a packed instrument id is a
       catalogue load-order index and moves under a delisting. -->
  <sbe:message name="ReconBreakMsg" id="9" description="Position reconciliation disagreement">
    <field name="verdict" id="1" type="reconVerdictEnum"/>
    <field name="venue" id="2" type="venueIdEnum"/>
    <field name="instrument" id="3" type="instrumentId"/>
    <field name="symbol" id="4" type="symbolText"/>
    <field name="localQty" id="5" type="qtyLots"/>
    <field name="venueQty" id="6" type="qtyLots"/>
    <field name="tsSeen" id="7" type="timestampNs"/>
  </sbe:message>
  <!-- One catalogue entry as a gateway numbered it. The symbol half of an
       instrument id is a load-order index, so an id means this instrument only
       within one gateway generation, from tsLoaded until the next. -->
  <sbe:message name="InstrumentMsg" id="11" description="Catalogue entry for one generation" sinceVersion="4">
    <field name="instrument" id="1" type="instrumentId"/>
    <field name="generation" id="2" type="uint64" description="the gateway segment's generation"/>
    <field name="symbol" id="3" type="symbolText"/>
    <field name="localSymbol" id="4" type="symbolText"/>
    <field name="kind" id="5" type="contractKindEnum"/>
    <field name="tickSize" id="6" type="fixedE9"/>
    <field name="lotSize" id="7" type="fixedE9"/>
    <field name="minNotional" id="8" type="fixedE9"/>
    <field name="contractValue" id="9" type="fixedE9"/>
    <field name="tsLoaded" id="10" type="timestampNs"/>
  </sbe:message>
</sbe:messageSchema>
