[Unit]
Description=raikiri admind
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raikiri
WorkingDirectory=/opt/raikiri
Restart=always
RestartSec=5s

RuntimeDirectory=raikiri
RuntimeDirectoryPreserve=yes
Environment=RAIKIRI_RUNTIME_DIR=/run/raikiri
Environment=RAIKIRI_DATA_DIR=/var/lib/raikiri
EnvironmentFile=-/etc/raikiri/raikiri.env

EnvironmentFile=-/etc/raikiri/database.env

# loopback only: admind checks the stream token and nothing else; caddy holds the password
ExecStart=/opt/raikiri/bin/admind --port 8787 --stream-port 8788 \
    --upstream boards=8790 $RAIKIRI_ADMIND_ARGS

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/raikiri /run/raikiri

[Install]
WantedBy=multi-user.target
