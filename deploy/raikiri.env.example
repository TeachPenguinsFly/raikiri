# Copied to /etc/raikiri/raikiri.env, 0644. Secrets do NOT belong here — see
# credentials.env.example for those.

# The venue set. Spot accounts are named in full: a spot leg with no perpetual
# to pair against is a process that costs a core share for no row.
RAIKIRI_VENUES="binance bybit okx kucoin xt hyperliquid bingx gate weex mexc"
RAIKIRI_SPOT="bybit-spot okx-spot kucoin-spot xt-spot hyperliquid-spot bingx-spot gate-spot mexc-spot"

# HOW MUCH JOURNAL THE BOX KEEPS, in sealed 256 MiB segments per account. Eight
# is two gibibytes an account. A persister further behind than that loses what
# it had not read, so a deployment that keeps its history must ship a sealed
# segment off the box faster than eight fill. 0 keeps everything and fills the
# disk, which is the library's own default for exactly that reason.
RAIKIRI_JOURNAL_RETAIN=8

# Postgres. Without it the history and PnL screens answer 503 and say which
# half is missing, which is the honest state rather than an empty list.
#RAIKIRI_PG_DSN=postgresql://raikiri:raikiri@localhost:5432/raikiri
