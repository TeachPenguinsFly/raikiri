#!/usr/bin/env bash
# called by the systemd template: gateway-run okx-spot
set -uo pipefail

ACCOUNT="${1:?usage: gateway-run <account>}"
ROOT="${RAIKIRI_ROOT:-/opt/raikiri}"

# shellcheck source=venue_args.sh
source "$ROOT/share/venue_args.sh"

read -r -a args <<< "$(venue_argv "$ACCOUNT")"

# RAIKIRI_CHANNELS_<ACCOUNT> narrows a venue's channels on this box, e.g. RAIKIRI_CHANNELS_OKX_SPOT=bbo,funding
override_var="RAIKIRI_CHANNELS_$(printf '%s' "$ACCOUNT" | tr 'a-z-' 'A-Z_')"
override="${!override_var:-}"
if [[ -n "$override" ]]; then
    for i in "${!args[@]}"; do
        [[ "${args[$i]}" == --channels=* ]] && unset 'args[i]'
    done
    args=("${args[@]}" "--channels=$override")
    echo "gateway-run: $ACCOUNT narrowed to $override by $override_var" >&2
fi

# exec: makes gatewayd run the fetch itself, so the key is not in argv, the environment or on disk
secret_ref() {
    printf 'exec:gcloud secrets versions access latest --secret=%s --quiet' "$1"
}

venue="${ACCOUNT%%-*}"

# RAIKIRI_PRIVATE_<ACCOUNT>=1 turns credentials on; check the key from this host's ip first
private_var="RAIKIRI_PRIVATE_$(printf '%s' "$ACCOUNT" | tr 'a-z-' 'A-Z_')"
if [[ -z "${!private_var:-}" ]]; then
    echo "gateway-run: $ACCOUNT on public data — set $private_var=1 once its key works here" >&2
elif ! gcloud --version >/dev/null 2>&1; then
    echo "gateway-run: gcloud will not run here — starting $ACCOUNT on PUBLIC DATA ONLY," \
         "whatever is in Secret Manager" >&2
elif gcloud secrets describe "${venue}-api-key" >/dev/null 2>&1; then
    args+=(--api-key="$(secret_ref "${venue}-api-key")")
    args+=(--api-secret="$(secret_ref "${venue}-api-secret")")
    if gcloud secrets describe "${venue}-passphrase" >/dev/null 2>&1; then
        args+=(--passphrase="$(secret_ref "${venue}-passphrase")")
    fi
fi

exec "$ROOT/bin/gatewayd" "${args[@]}"
