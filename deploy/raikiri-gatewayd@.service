[Unit]
Description=raikiri gateway — %i
After=network-online.target
Wants=network-online.target

# these belong in [Unit]; systemd ignores them in [Service]
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=raikiri
WorkingDirectory=/opt/raikiri

Restart=always
RestartSec=5s
# keep static tls well under the 8 MiB default stack (readelf -lW gatewayd | grep TLS)

RuntimeDirectory=raikiri
RuntimeDirectoryPreserve=yes
Environment=RAIKIRI_RUNTIME_DIR=/run/raikiri
Environment=RAIKIRI_DATA_DIR=/var/lib/raikiri

# without the budget file the gateway runs unlimited and venues ban the ip
Environment=RAIKIRI_CONFIG_DIR=/etc/raikiri/config

# gcloud needs a writable HOME; use the apt gcloud, the snap cannot run under NoNewPrivileges
Environment=HOME=/var/lib/raikiri-home
Environment=CLOUDSDK_CONFIG=/var/lib/raikiri-home/.gcloud

EnvironmentFile=-/etc/raikiri/credentials.env
EnvironmentFile=-/etc/raikiri/raikiri.env

ExecStart=/opt/raikiri/bin/gateway-run %i

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/raikiri /run/raikiri /var/lib/raikiri-home

[Install]
WantedBy=multi-user.target
