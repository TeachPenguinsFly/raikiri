:80 {
	encode zstd gzip

	# browsers send no basic auth on a websocket upgrade, so admind checks the stream's ?token= instead;
	# the token comes from /v1/stream/token, which stays behind basic auth
	# the bcrypt hash lives in /etc/caddy/terminal.env, not in this file
	@guarded not path /v1/stream
	basic_auth @guarded {
		admin {env.RAIKIRI_TERMINAL_HASH}
	}

	# placing orders and opening client books are refused from outside; this must be a handle and come first
	@place_order {
		method POST
		path /v1/orders /v1/books
	}
	handle @place_order {
		respond "order entry is not exposed" 403
	}

	# handle blocks run in order; bare directives get re-sorted and try_files would rewrite /v1

	# exact, before /v1/*: /v1/stream/token is an ordinary admind route
	handle /v1/stream {
		reverse_proxy 127.0.0.1:8788
	}

	# admind books a hand order to manual:<login>; this replaces whatever the client sent
	handle /v1/* {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Raikiri-Login {http.auth.user.id}
		}
	}

	handle {
		root * /opt/raikiri/web
		try_files {path} /index.html
		file_server
	}
}
