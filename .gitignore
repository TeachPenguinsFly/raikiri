# A COPY IS THE SAME SECRET. These two hold 1Password references, and the
# vault name in them is not ours to publish — a hand-made .bak beside the
# original would carry it into the history where no later edit removes it.
tools/credentials.env.*
tools/op.env.*
!tools/credentials.env.example
!tools/op.env.example
.venv-test/
.claude/

# Python bytecode from tools/
__pycache__/
.pytest_cache/

# Notes, research and the fuzz harnesses stay on this machine; only their READMEs are published.
docs/*
!docs/README.md
fuzz/*
!fuzz/README.md
