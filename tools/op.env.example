# The 1Password service-account token for this machine. Copy to tools/op.env,
# which is gitignored.
#
# A service account authenticates over the network with no desktop app in the
# loop, so macOS never asks a terminal for permission to control one — which is
# the whole reason this exists. It also works headless, which the desktop-app
# path does not.
#
#   eval "$(op signin)"
#   op service-account create raikiri-dev \
#       --expires-in 90d --vault "<the vault holding the venue keys>:read_items"
#
# The vault named here MUST be the one tools/credentials.env references. A
# service account sees only the vaults it was granted, and a reference into any
# other resolves to nothing — which looks exactly like having no token at all.
# Pins every op call to one account. Without it the CLI searches every account
# added on this machine, which reaches into vaults unrelated to this repo.
export OP_ACCOUNT=<your>.1password.com
export OP_SERVICE_ACCOUNT_TOKEN=ops_REPLACE_ME
